# ─────────────────────────────────────────────────────────────
# Helix Agent — Environment Variables
# Copy this file to .env and fill in all values marked <...>
# NEVER commit .env to git. It is in .gitignore.
# ─────────────────────────────────────────────────────────────

# Google OAuth (Desktop app credentials)
GOOGLE_CREDENTIALS_PATH=./credentials.json
GOOGLE_TOKEN_PATH=./token.json

# Google Search Console
# The exact property URL as it appears in GSC (include trailing slash)
GSC_SITE_URL=https://hellotools.net/

# Google Sheets
# From the URL: docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
SPREADSHEET_ID=<your_spreadsheet_id>

# Gemini API
# From: aistudio.google.com → Get API Key
GEMINI_API_KEY=<your_gemini_api_key>
GEMINI_MODEL=gemini-2.5-flash

# Gmail — sender and recipient
# Must be the same Gmail account the App Password was generated for
GMAIL_ADDRESS=<your@gmail.com>
# From: myaccount.google.com → Security → 2-Step Verification → App Passwords
# Format: xxxx xxxx xxxx xxxx (16 chars, spaces optional)
GMAIL_APP_PASSWORD=<xxxx-xxxx-xxxx-xxxx>
# Where the Monday brief and P0 alerts are sent
REPORT_EMAIL=<your@gmail.com>

# Google PageSpeed Insights
# From: console.cloud.google.com → Credentials → API Key
# Enable: PageSpeed Insights API
PAGESPEED_API_KEY=<your_pagespeed_api_key>

# Competitor tracking (Step 7)
# No API key needed — scrape_competitors.py uses Playwright to visit competitor
# tool directories directly and detect gaps vs our tools in test_cases.json.
# Competitor URLs are configured in directives/config.json

# AdSense Revenue Estimation
# Conservative baseline RPM ($4.00 per 1,000 impressions). Update once real AdSense RPM data is available.
ESTIMATED_ADSENSE_RPM=4.00

